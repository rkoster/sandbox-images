#!/bin/sh
set -eu

# CF's Docker lifecycle replaces the image PATH with its container PATH.
# Restore the bundled toolchain paths for execd-launched commands and workloads.
PATH="/opt/stack/bin:/usr/local/bin:/usr/bin:/bin"
export PATH
GOROOT=/opt/stack
GOPATH=${GOPATH:-/workspace/go}
GEM_HOME=${GEM_HOME:-/workspace/gems}
GEM_PATH="/opt/stack:/workspace/gems"
BUNDLE_PATH=${BUNDLE_PATH:-/workspace/bundle}
HOME=${HOME:-/workspace/home}
export GOROOT GOPATH GEM_HOME GEM_PATH BUNDLE_PATH HOME

execd_pid=
workload_pid=

shutdown() {
  trap - TERM INT
  [ -z "${workload_pid}" ] || kill -TERM "${workload_pid}" 2>/dev/null || true
  [ -z "${execd_pid}" ] || kill -TERM "${execd_pid}" 2>/dev/null || true
  [ -z "${workload_pid}" ] || wait "${workload_pid}" 2>/dev/null || true
  [ -z "${execd_pid}" ] || wait "${execd_pid}" 2>/dev/null || true
}
trap shutdown TERM INT

/opt/opensandbox/execd &
execd_pid=$!

if [ "$#" -gt 0 ]; then
  "$@" &
  workload_pid=$!
  set +e
  wait "$workload_pid"
  status=$?
  set -e
  workload_pid=
  kill -TERM "$execd_pid" 2>/dev/null || true
  wait "$execd_pid" 2>/dev/null || true
  execd_pid=
  exit "$status"
fi

wait "$execd_pid"
